# Build outputs (never copy Windows/macOS build artifacts into Linux images)
**/bin/
**/obj/
**/out/
**/publish/

# IDE / tooling
**/.vs/
**/.idea/
**/*.user
**/*.suo

# Python
**/__pycache__/
**/.pytest_cache/
**/.venv/
**/venv/
**/*.egg-info/

# Local data & secrets
**/.env
**/.env.*
!**/.env.example
**/*.db
**/*.db-shm
**/*.db-wal
**/data/

# Git
.git/
.gitignore

# Docs / misc not needed in images
**/.cursor/
**/TestResults/
