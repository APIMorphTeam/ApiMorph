{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/apimorph.db"
  },
  "Engine": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 60
  },
  "Llm": {
    "Enabled": false
  },
  "GitHub": {
    "Token": "",
    "AutoMerge": false,
    "AutoCreatePullRequest": false,
    "BranchPrefix": "apimorph",
    "WorkspacePath": "/workspace",
    "CommitAuthorName": "ApiMorph Bot",
    "CommitAuthorEmail": "apimorph-bot@users.noreply.github.com"
  }
}
