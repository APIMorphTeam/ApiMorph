# GitHub (Stage 4)
# GITHUB_TOKEN=ghp_...
GitHub__Token=
GitHub__AutoCreatePullRequest=false
GitHub__CommitAuthorName=ApiMorph Bot
GitHub__CommitAuthorEmail=apimorph-bot@users.noreply.github.com

# Patches (Stage 5) — deterministic fixes applied to draft PR when enabled
Patch__Enabled=true

# LLM (Stage 5) — optional BYOK or local Ollama for harder migrations
Llm__Enabled=false
LLM__PROVIDER=ollama
LLM__MODEL=llama3.2
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434

AUTO_MERGE=false
