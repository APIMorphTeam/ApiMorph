# =============================================================================
# ApiMorph deploy secrets (self-hosted operators)
# =============================================================================
# End users configure secrets via this file + PEM mounts.
# You do NOT need `dotnet user-secrets` — that is optional for local .NET SDK
# developers only (see docs/github-app.md).
# =============================================================================

# --- GitHub App (preferred, Stage 7) ---
# Create at: GitHub → Settings → Developer settings → GitHub Apps
# Permissions: Contents (R/W), Pull requests (R/W), Metadata (R)
GitHub__AppId=
GitHub__InstallationId=
# Numeric id, or paste the installations URL (ApiMorph extracts the trailing number)
# Path inside the orchestrator container (default compose mount):
GitHub__AppPrivateKeyPath=/run/secrets/github-app.pem
# Place the downloaded private key at: deploy/secrets/github-app.pem
# (gitignored — never commit)
GitHub__WebhookSecret=

# --- PAT fallback (demos / migration only) ---
# Prefer App above. Fine-scoped PAT needs contents + pull_requests.
GitHub__Token=
GitHub__CommitAuthorName=ApiMorph Bot
GitHub__CommitAuthorEmail=apimorph-bot@users.noreply.github.com

# Patches (Stage 5)
Patch__Enabled=true

# LLM (Stage 5) — optional
Llm__Enabled=false
LLM__PROVIDER=ollama
LLM__MODEL=qwen2.5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_BASE_URL is for the engine container (use host.docker.internal on Docker Desktop)
OLLAMA_BASE_URL=http://host.docker.internal:11434

AUTO_MERGE=false
